    "definitions": {
      "PointsConfig": {
        "required": [
          "membership_level"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "ID",
            "type": "integer",
            "readOnly": true
          },
          "membership_level": {
            "title": "Membership level",
            "type": "string",
            "enum": [
              "bronze",
              "silver",
              "gold"
            ]
          },
          "multiplier": {
            "title": "Multiplier",
            "type": "string",
            "format": "decimal"
          },
          "threshold": {
            "title": "Threshold",
            "type": "string",
            "format": "decimal"
          }
        }
      },
      "TokenObtainPair": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "title": "Username",
            "type": "string",
            "minLength": 1
          },
          "password": {
            "title": "Password",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "TokenRefresh": {
        "required": [
          "refresh"
        ],
        "type": "object",
        "properties": {
          "refresh": {
            "title": "Refresh",
            "type": "string",
            "minLength": 1
          },
          "access": {
            "title": "Access",
            "type": "string",
            "readOnly": true,
            "minLength": 1
          }
        }
      },
      "PaymentTransaction": {
        "required": [
          "amount",
          "payment_method",
          "status",
          "user"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "ID",
            "type": "integer",
            "readOnly": true
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "amount": {
            "title": "Amount",
            "type": "string",
            "format": "decimal"
          },
          "points_used": {
            "title": "Points used",
            "type": "string",
            "format": "decimal"
          },
          "points_earned": {
            "title": "Points earned",
            "type": "string",
            "format": "decimal"
          },
          "payment_method": {
            "title": "Payment method",
            "type": "string",
            "enum": [
              "Points",
              "Dummy Virtual Account",
              "Dummy Credit Card"
            ]
          },
          "status": {
            "title": "Status",
            "type": "string",
            "enum": [
              "Success",
              "Failed"
            ]
          },
          "failure_reason": {
            "title": "Failure reason",
            "type": "string",
            "maxLength": 255,
            "x-nullable": true
          },
          "user": {
            "title": "User",
            "type": "integer"
          }
        }
      },
      "User": {
        "required": [
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "ID",
            "type": "integer",
            "readOnly": true
          },
          "username": {
            "title": "Username",
            "description": "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.",
            "type": "string",
            "pattern": "^[\\w.@+-]+$",
            "maxLength": 150,
            "minLength": 1
          },
          "email": {
            "title": "Email",
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 1
          },
          "points_balance": {
            "title": "Points balance",
            "type": "string",
            "format": "decimal"
          },
          "membership_status": {
            "title": "Membership status",
            "type": "string",
            "maxLength": 20,
            "minLength": 1
          }
        }
      },
      "Register": {
        "required": [
          "username",
          "email",
          "password",
          "password2"
        ],
        "type": "object",
        "properties": {
          "username": {
            "title": "Username",
            "description": "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.",
            "type": "string",
            "pattern": "^[\\w.@+-]+$",
            "maxLength": 150,
            "minLength": 1
          },
          "email": {
            "title": "Email",
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 1
          },
          "password": {
            "title": "Password",
            "type": "string",
            "minLength": 1
          },
          "password2": {
            "title": "Password2",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Voucher": {
        "required": [
          "name",
          "description",
          "points_required"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "ID",
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "title": "Name",
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "description": {
            "title": "Description",
            "type": "string",
            "minLength": 1
          },
          "points_required": {
            "title": "Points required",
            "type": "string",
            "format": "decimal"
          }
        }
      }
    }
